# Copy to .env for local runs. On Vercel, set the same names under
# Project -> Settings -> Environment Variables. Never commit real keys.

# Language model: any OpenAI-compatible API
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=minimal

# Alternatives:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:3b   (no key)

# Optional tuning (defaults shown)
# TOP_K=5
# CACHE_THRESHOLD=0.85
# EVIDENCE_THRESHOLD=0.40
# SUPPORT_THRESHOLD=0.40
# CACHE_TTL_DAYS=30
# CACHE_FILE=data/cache/cache.jsonl   # persist the cache locally

# Shared cache for all server instances (Upstash Redis, free tier).
# On Vercel these are added automatically when you connect Upstash Redis
# from the Storage tab (names may also be KV_REST_API_URL / KV_REST_API_TOKEN).
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# RATE_LIMIT_PER_MIN=20
